msgid ""
"Basic Automatic Display is enabled for %1$s. To avoid duplicate buttons, turn it off "
"under %2$sSettings → Configuration → Content Types%3$s for those types. If multiple "
"rules target the same placement, only keep one active rule or use different filters."
msgstr ""
