msgstr "ヘッダー列の幅"

#: admin/includes/classes/class-options-panel.php:2197
msgid "Tabs column width"
msgstr "タブの列幅"

#: admin/includes/classes/class-options-panel.php:2207
msgid "Header info width"
msgstr "ヘッダー情報幅"

#: admin/includes/classes/class-options-panel.php:2213
msgid "Header badges width"
msgstr "ヘッダーバッジ幅"

#: admin/includes/classes/class-options-panel.php:2223
