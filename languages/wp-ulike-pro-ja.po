msgstr "名前と姓（'-' 使用）"

#: admin/includes/classes/class-options-panel.php:1901
msgid "First and Last Name with '+'"
msgstr "名前と姓（'+' 使用）"

#: admin/includes/classes/class-options-panel.php:1910
